# ── SIGNAL marketing agent ─────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored.

# Claude (content generation). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model.
ANTHROPIC_MODEL=claude-opus-4-8

# X / Twitter — OAuth 1.0a user context (needed to POST tweets).
# Create an app at https://developer.x.com/ , give it Read+Write,
# then generate API key/secret AND an access token/secret for YOUR account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Behaviour knobs (all optional) ─────────────────────────────────────────
# Stay safely under the X free-tier monthly write cap (free is ~500/mo).
MONTHLY_POST_CAP=450
# Minimum minutes between posts (the launchd job fires every 120; this is a guard).
MIN_MINUTES_BETWEEN_POSTS=110
# Your X handle (used only for log links, no @).
X_HANDLE=
# Public site to link in some posts.
SITE_URL=https://getsignal.co.in
