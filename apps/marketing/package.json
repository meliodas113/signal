{
  "name": "@signal/marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIGNAL autonomous marketing team — generates branded content and posts to X/Twitter on a schedule.",
  "scripts": {
    "post": "tsx src/index.ts",
    "post:dry": "tsx src/index.ts --dry-run",
    "preview": "tsx src/index.ts --dry-run --open",
    "loop": "tsx src/loop.ts",
    "schedule:install": "bash src/scheduler/install-schedule.sh install",
    "schedule:uninstall": "bash src/scheduler/install-schedule.sh uninstall",
    "schedule:status": "bash src/scheduler/install-schedule.sh status",
    "browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.1",
    "rss-parser": "^3.13.0",
    "twitter-api-v2": "^1.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
