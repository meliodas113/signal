# Copy to apps/landing/.env and fill in. Vite exposes VITE_* vars to the client.
# Both values come from your Supabase project: Project Settings -> API.

# Base URL of your Supabase project (no trailing slash)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key — safe to ship in the browser
VITE_SUPABASE_ANON_KEY=your-anon-key
