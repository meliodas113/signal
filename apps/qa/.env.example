# ── SIGNAL QA agent ────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored.

# Linear — a Personal API key. Create one at:
#   Linear → Settings → Security & access → Personal API keys
# The agent files bugs into the "Signal" team by default.
LINEAR_API_KEY=lin_api_...
# Optional: override the team the agent files into (defaults to the Signal team).
LINEAR_TEAM_ID=e77412b1-efeb-4abd-bf28-d573f5bd2031

# ── What to test ───────────────────────────────────────────────────────────
# Leave QA_TARGET_URL empty to auto-start the local apps/landing dev server and
# test it (the default). Set it to test a deployed site instead, e.g.:
#   QA_TARGET_URL=https://getsignal.co.in
QA_TARGET_URL=

# A clearly-fake address for the signup-flow check, so it never pollutes a list.
QA_TEST_EMAIL=qa-bot@example.com

# ── Behaviour knobs (all optional) ─────────────────────────────────────────
# Don't refile the same bug more often than this many hours (dedupe window).
QA_REFILE_COOLDOWN_HOURS=168
# `npm run loop` cadence (the launchd job uses its own 6h interval).
QA_LOOP_INTERVAL_HOURS=6
